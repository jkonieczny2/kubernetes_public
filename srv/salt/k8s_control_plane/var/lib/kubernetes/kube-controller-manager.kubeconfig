apiVersion: v1
clusters:
- cluster:
    certificate-authority: /var/lib/kubernetes/ca.crt
    server: https://k8s-control-plane-1.kubernetes.local:6443
  name: kubernetes-cluster-1
contexts:
- context:
    cluster: kubernetes-cluster-1
    user: system:kube-controller-manager
  name: default
current-context: default
kind: Config
preferences: {}
users:
- name: system:kube-controller-manager
  user:
    client-certificate: /var/lib/kubernetes/kube-controller-manager.crt
    client-key: /var/lib/kubernetes/kube-controller-manager.key
