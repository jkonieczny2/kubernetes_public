[Unit]
Description=kubelet: The Kubernetes Node Agent
Documentation=https://kubernetes.io/docs/
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/kubelet --config /var/lib/kubelet/config.yaml --kubeconfig /etc/kubernetes/kubelet.conf --register-with-taints=ebs.csi.aws.com/agent-not-ready:NoSchedule
Restart=always
StartLimitInterval=0
RestartSec=10

[Install]
WantedBy=multi-user.target
