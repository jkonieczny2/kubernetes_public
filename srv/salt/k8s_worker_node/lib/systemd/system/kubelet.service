[Unit]
Description=kubelet: The Kubernetes Node Agent
Documentation=https://kubernetes.io/docs/
Wants=network-online.target
After=network-online.target

[Service]
ExecStart=/usr/local/bin/kubelet --config /etc/kubernetes/kubelet-config.yaml --kubeconfig /var/lib/kubernetes/kubelet.kubeconfig --resolv-conf /etc/kubernetes/resolv.conf
Restart=always
StartLimitInterval=0
RestartSec=10

[Install]
WantedBy=multi-user.target
