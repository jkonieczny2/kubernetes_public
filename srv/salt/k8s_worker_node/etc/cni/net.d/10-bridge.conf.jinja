{%- set id = grains['id'] -%}
{%- set cluster_name = pillar['hostnames'][id]['cluster'] -%}
{
  "cniVersion": "1.0.0",
  "name": "bridge",
  "type": "bridge",
  "bridge": "cni0",
  "isGateway": true,
  "ipMasq": true,
  "ipam": {
    "type": "host-local",
    "ranges": [
      [{"subnet": "{{ pillar['clusters'][cluster_name]['worker_nodes'][id]['pod_subnet'] }}"}]
    ],
    "routes": [{"dst": "0.0.0.0/0"}]
  }
}
